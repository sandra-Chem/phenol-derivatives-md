; Conjugate-gradient energy minimization

integrator      = cg
nsteps          = 5000
emtol           = 10

nstlist         = 10
cutoff-scheme   = Verlet
rlist           = 1.2

coulombtype     = PME
rcoulomb        = 1.2

vdw-type        = cutoff
vdw-modifier    = force-switch
rvdw-switch     = 1.0
rvdw            = 1.2

pbc             = xyz
DispCorr        = no
